# 第一版 demo / tool 不读这些。role-crew run 才用。
#
# Token Plan（sk-sp- + 下面这个入口），不要拿去打普通 dashscope 看图。
# LLM_API_KEY=sk-sp-your-key
# LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=glm-5-2
#
# 百炼按量通用 Key（sk- 开头，没有 -sp-）：
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

LLM_API_KEY=
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=glm-5-2
MAX_AGENT_STEPS=16
MAX_PEER_DEPTH=2
